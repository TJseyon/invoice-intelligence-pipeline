# Copy to .env and fill in to use real LLM extraction.
# Leave LLM_PROVIDER=mock to run the entire pipeline offline with zero API cost
# (a deterministic regex-based extractor stands in for the LLM -- see
# backend/app/extraction.py::_mock_extract). This is the default and is what
# docker-compose uses if you don't set anything. It only understands the
# exact label format of the bundled sample invoices (see backend/eval/data) --
# for real-world documents of your own, use one of the two real providers below.

LLM_PROVIDER=mock

# --- Option A: Gemini -- genuinely free, no credit card. This is what to use
# for a public deployment anyone (friends, recruiters) can use for free.
# Get a key at https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Option B: Anthropic -- paid (pay-as-you-go, no ongoing free tier), but
# generally the strongest extraction quality. Get a key at
# https://console.anthropic.com/settings/keys
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

OCR_LANGUAGES=eng
